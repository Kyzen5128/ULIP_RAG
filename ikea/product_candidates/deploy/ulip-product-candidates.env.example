# Copy this template OUTSIDE the repository and replace both placeholders.
# The real EnvironmentFile must be owned by the operator and mode 0600.
# Never commit, print, or paste the real bearer token into handoff/log output.

# Absolute path to one immutable deployment profile directory or manifest.
PRODUCT_CANDIDATES_PROFILE=/mnt/P300/data/ULIP/product_candidates/deployments/REPLACE_WITH_PROFILE

# Generate at least 32 random bytes; store only the encoded token here.
PRODUCT_CANDIDATES_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional interpreter override. The ASGI module is deliberately fixed by the
# launcher and cannot be selected from this EnvironmentFile.
PRODUCT_CANDIDATES_PYTHON=/home/kyzen/miniconda3/envs/ulip/bin/python
