{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:v2t-camera:ulip-product-candidate-request:1.0",
  "title": "V2T to ULIP product candidate request v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "query_text",
    "categories_primary",
    "categories_secondary",
    "top_k_per_tier"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "categories_primary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "categories_secondary": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "top_k_per_tier": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
